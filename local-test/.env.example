# Copy to .env and fill in. Never commit .env.
LITELLM_MASTER_KEY=sk-local-change-me
LITELLM_SALT_KEY=local-salt-change-me
# Bedrock API key from the AWS console (Amazon Bedrock -> API keys), starts with ABSK
AWS_BEARER_TOKEN_BEDROCK=ABSK-paste-here
# Optional: only if your PC can reach the corporate LiteLLM (then uncomment the corp/ models in config.yaml)
# CORP_LITELLM_URL=https://litellm.your-company.internal
# CORP_LITELLM_KEY=sk-your-corporate-key
